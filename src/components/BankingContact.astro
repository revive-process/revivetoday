---
const email = 'connect@revivetoday.com';
const subject = 'Banking walkthrough — business customer onboarding';
const body = 'We would like to discuss business customer onboarding.\n\nBank / team:\nServices or journey of interest:\nWhere we would like more visibility:\n';
const href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---
<section class="bv-contact" id="request-walkthrough" aria-labelledby="walkthrough-title">
  <div class="bv-shell bv-contact-grid">
    <div><p class="bv-eyebrow">A practical next step</p><h2 id="walkthrough-title">Which customer journey would you like to understand?</h2><p>Request a banking walkthrough. We can discuss the services involved, the records available and a sensible starting scope.</p></div>
    <div class="bv-contact-action"><a class="bv-btn" href={href}>Request a banking walkthrough <span aria-hidden="true">↗</span></a><p>Reply to the email that brought you here, or contact <a href={`mailto:${email}`}>{email}</a>.</p><a class="bv-text-link" href="https://re-vive.com/company/contact">Other contact options →</a></div>
  </div>
</section>
