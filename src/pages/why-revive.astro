olor:white;text-decoration:none;border-radius:9px;padding:13px 19px;font-weight:750}.btn.outline{border:1px solid #c1d1e0;color:var(--navy);background:white}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.svg-panel{border-radius:22px;background:white;box-shadow:0 22px 65px #172f5021;border:1px solid #e3edf5;padding:15px}.svg-panel svg{width:100%;height:auto;display:block}.pill{display:inline-block;border-radius:100px;padding:5px 11px;background:#e4f2ef;color:#17786e;font-size:.78rem;font-weight:800}.proof{font-size:clamp(2.2rem,4vw,3.5rem);font-weight:850;line-height:1;color:var(--navy);letter-spacing:-.04em}.muted{color:var(--muted)}.mini{font-size:.86rem}.compare{display:grid;grid-template-columns:1fr 1fr;gap:22px}.compare>div{padding:30px;border-radius:18px;background:white;border:1px solid var(--line)}.compare>div:last-child{background:#e8f5f2;border-color:#a8d4c8}.stack{display:grid;gap:10px;margin:22px 0}.step{border:1px solid #d7e5ee;border-radius:10px;padding:12px 14px;font-weight:650;background:#f8fbfd}.compare>div:last-child .step{border-color:#a5d5c9;background:white}.arrow{text-align:center;font-size:22px;color:var(--teal)}.evidence{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.trace{background:white;border:1px solid var(--line);border-radius:18px;padding:22px}.trace .line{padding:13px;border-left:3px solid #8daac0;margin:0 0 0 12px;position:relative}.trace .line:before{content:'';position:absolute;left:-8px;top:19px;width:12px;height:12px;border-radius:50%;background:#237f78;border:2px solid white}.trace strong{display:block}.metric-band{display:flex;height:20px;border-radius:7px;overflow:hidden;margin:18px 0 12px}.metric-band span:nth-child(1){background:#178377;flex:72}.metric-band span:nth-child(2){background:#427cb8;flex:17}.metric-band span:nth-child(3){background:#7657b7;flex:8}.metric-band span:nth-child(4){background:#d08b43;flex:3}.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:.82rem}.legend b{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}.stat{font-size:3.2rem;font-weight:850;letter-spacing:-.05em;line-height:1.1}.research{padding:0;margin:0;list-style:none}.research li{border-top:1px solid var(--line);padding:19px 0}.research a{font-weight:800;color:#22699f}.research small{display:block;color:#65768a;margin-top:4px}.footnote{font-size:.83rem;color:#64768a}.quote{font-size:clamp(1.4rem,2.6vw,2.3rem);font-weight:750;line-height:1.38;color:var(--navy)}.bottom{background:linear-gradient(130deg,#15365a,#1b5369);color:white;padding:70px 0}.bottom p{color:#d7e5ee}.rt-header{position:sticky;top:0;z-index:20;background:#fff;box-shadow:0 2px 16px #0b294019}.rt-shell{max-width:1240px;margin:auto;padding:13px 24px;display:flex;align-items:center;gap:24px;justify-content:space-between}.rt-brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-size:.78rem;font-weight:700;color:#46637d;white-space:nowrap}.rt-brand img{width:125px;max-height:43px;object-fit:contain}.rt-nav{display:flex;align-items:center;gap:16px}.rt-nav>a,.rt-parent{font-size:.87rem;font-weight:700;text-decoration:none;white-space:nowrap}.rt-nav .active{color:var(--teal)}.rt-item{position:relative}.rt-sub{display:none;position:absolute;top:100%;left:0;min-width:225px;background:white;border:1px solid var(--line);box-shadow:0 10px 35px #122c4933;border-radius:8px;padding:8px}.rt-sub a{display:block;padding:9px 10px;text-decoration:none;font-size:.85rem}.rt-sub a:hover{background:#eff7f7}.rt-item:hover .rt-sub,.rt-item:focus-within .rt-sub{display:block}.rt-toggle{display:none}.rt-nav>a:last-child{background:var(--navy);color:white;padding:9px 15px;border-radius:8px}footer{padding:28px 0;border-top:1px solid var(--line);color:#66788a;font-size:.84rem}@media(max-width:980px){.rt-toggle{display:block;border:1px solid var(--line);background:white;border-radius:7px;padding:7px 12px;font-size:22px}.rt-nav{display:none;position:absolute;top:65px;left:0;right:0;background:wh