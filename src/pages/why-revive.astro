<rect fill="url(#loanBg)" height="430" rx="18" width="510"></rect>
<text fill="#325773" font-size="13" font-weight="800" x="24" y="34">WHAT YOUR BANKING SYSTEMS RECORD</text>
<g fill="white" stroke="#d5e4ee"><rect height="51" rx="9" width="146" x="19" y="49"></rect><rect height="51" rx="9" width="146" x="182" y="49"></rect><rect height="51" rx="9" width="146" x="345" y="49"></rect></g>
