<Layout title="Financial Services Execution Intelligence | RE-ViVE" description="Banking, capital markets and ETF operations" current="/financial-services" footer={false}>
<Fragment slot="head">
<link href="/images/favicon.svg" rel="icon" type="image/svg+xml"/><link href="/assets/css/site.css" rel="stylesheet"/><link href="/assets/css/chrome.css" rel="stylesheet"/><link href="/assets/css/banking-extension.css" rel="stylesheet"/><link href="/assets/css/banking-v2.css" rel="stylesheet"/><link href="/assets/css/banking-v3.css" rel="stylesheet"/><link href="/assets/css/banking-nav-v4.css" rel="stylesheet"/><link href="/assets/css/banking-production-v7.css" rel="stylesheet"/>
