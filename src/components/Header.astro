---
// Shared header and main navigation. `current` is the page path ("/workflows").
// A top-level item is marked active when it is the current page or when one of
// its drop-down links is; the exact page link also gets aria-current="page".
const { current = "" } = Astro.props;

const NAV = [
  { label: "Banking Home", href: "/" },
  { label: "Banking Solutions", href: "/workflows", sub: [
    { label: "Banking Workflows", href: "/workflows" },
    { label: "Community Banks", href: "/banking-community-banks" },
    { label: "Regional & Mid-size Banks", href: "/banking-regional-banks" },
    { label: "Large & Global Banks", href: "/banking-large-banks" },
  ]},
  { label: "Why RE-ViVE", href: "/why-revive" },
  { label: "Platform", href: "/platform", sub: [
    { label: "Platform Overview", href: "/platform" },
    { label: "Execution Intelligence", href: "/execution-intelligence" },
    { label: "AI Execution Intelligence", href: "/enterprise-ai" },
    { label: "Architecture & Deployment", href: "/platform-deployment" },
  ]},
  { label: "Other Industries", href: "/industries", sub: [
    { label: "Capital Markets", href: "/industry-capital-markets" },
    { label: "Insurance", href: "/industry-insurance" },
    { label: "Healthcare", href: "/industry-healthcare" },
    { label: "More on RE-ViVE.com ↗", href: "https://re-vive.com/" },
  ]},
];

const CONTACT = { label: "Connect", href: "https://re-vive.com/company/contact" };

const isCurrent = (href) => href === current;
const parentActive = (item) => isCurrent(item.href) || (item.sub ?? []).some((s) => isCurrent(s.href));
const cls = (...parts) => parts.filter(Boolean).join(" ") || undefined;
---
<header class="rt-header">
<div class="rt-shell">
<a class="rt-brand" href="/"><img alt="RE-ViVE" decoding="async" src="/images/revive-logo-default-240.webp"/><span>Execution Intelligence</span></a>
<button aria-controls="rt-nav" aria-expanded="false" aria-label="Menu" class="rt-toggle" onclick="var n=document.getElementById('rt-nav');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)" type="button">☰</button>
<nav aria-label="Main" class="rt-nav" id="rt-nav">
{NAV.map((item) => item.sub ? (
<div class="rt-item"><a aria-current={isCurrent(item.href) ? "page" : undefined} class={cls(parentActive(item) && "active", "rt-parent")} href={item.href}>{item.label}</a><div class="rt-sub">{item.sub.map((s) => (
<a aria-current={isCurrent(s.href) ? "page" : undefined} class={cls(isCurrent(s.href) && "active")} href={s.href}>{s.label}</a>
))}</div></div>
) : (
<a aria-current={isCurrent(item.href) ? "page" : undefined} class={cls(isCurrent(item.href) && "active")} href={item.href}>{item.label}</a>
))}
<a class="rt-contact" href={CONTACT.href}>{CONTACT.label}</a>
</nav>
</div>
</header>
